generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReportType {
  CONTROLEURS
  RAME_BONDEE
  ESCALATOR_PANNE
  ASCENSEUR_PANNE
  RETARD_NON_SIGNALE
  GREVE
}

enum ReportLocationType {
  PLATFORM
  TRANSFER_CORRIDOR
  STATION_EXIT
}

enum TransportType {
  METRO
  RER
  TRAM
  BUS
  TRANSILIEN
}

model Line {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  transportType TransportType
  color         String
  textColor     String        @default("#FFFFFF")
  isActive      Boolean       @default(true)
  idfmId        String?
  lineStops     LineStop[]

  @@index([transportType])
}

model Station {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  latitude     Float
  longitude    Float
  isAccessible Boolean   @default(false)
  municipality String?
  lineStops    LineStop[]
  reports      Report[]

  @@index([name])
  @@index([latitude, longitude])
}

model LineStop {
  id               String       @id @default(cuid())
  position         Int
  travelTimeToNext Int?
  lineId           String
  stationId        String
  line             Line         @relation(fields: [lineId], references: [id], onDelete: Cascade)
  station          Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)
  connectionsFrom  Connection[] @relation("ConnectionFrom")
  connectionsTo    Connection[] @relation("ConnectionTo")
  idfmMapping      IdfmStopMapping?

  @@unique([lineId, position])
  @@index([lineId, stationId])
  @@index([stationId])
}

model Connection {
  id             String   @id @default(cuid())
  walkingTime    Int
  fromLineStopId String
  toLineStopId   String
  fromLineStop   LineStop @relation("ConnectionFrom", fields: [fromLineStopId], references: [id], onDelete: Cascade)
  toLineStop     LineStop @relation("ConnectionTo", fields: [toLineStopId], references: [id], onDelete: Cascade)

  @@unique([fromLineStopId, toLineStopId])
}

model IdfmStopMapping {
  id          String   @id @default(cuid())
  lineStopId  String   @unique
  idfmStopId  String
  isStopArea  Boolean  @default(false)
  lineStop    LineStop  @relation(fields: [lineStopId], references: [id], onDelete: Cascade)
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  displayName           String?
  emailVerified         Boolean   @default(false)
  verificationCode      String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int       @default(0)
  theme                 String    @default("dark")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sessions              Session[]
  favorites             Favorite[]
  reports               Report[]
  reportUpvotes         ReportUpvote[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromLat   Float
  fromLng   Float
  fromLabel String
  toLat     Float
  toLng     Float
  toLabel   String
  createdAt DateTime @default(now())

  @@unique([userId, fromLat, fromLng, toLat, toLng])
  @@index([userId])
}

model Report {
  id            String             @id @default(cuid())
  type          ReportType
  locationType  ReportLocationType
  stationId     String
  station       Station            @relation(fields: [stationId], references: [id], onDelete: Cascade)
  lineCode      String?
  direction     String?
  fromLineCode  String?
  toLineCode    String?
  comment       String?
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  upvoteCount   Int                @default(0)
  expiresAt     DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  upvotes       ReportUpvote[]

  @@index([stationId])
  @@index([expiresAt])
  @@index([type])
  @@index([lineCode])
  @@index([createdAt])
}

model ReportUpvote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId])
  @@index([reportId])
  @@index([userId])
}
