# CityTracker Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string (required)
#
# For local Docker (dev):
#   DATABASE_URL=postgresql://citytracker:citytracker@localhost:5432/citytracker
#
# For Neon (production):
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
DATABASE_URL=postgresql://citytracker:citytracker@localhost:5432/citytracker

# Direct PostgreSQL URL (required for Prisma migrations)
# For local Docker: same as DATABASE_URL
# For Neon: use the non-pooler (direct) URL from Neon dashboard
DIRECT_URL=postgresql://citytracker:citytracker@localhost:5432/citytracker

# ─── APIs ────────────────────────────────────────────────────
# IDFM PRIM API key for real-time departures & disruptions (optional)
# Get one at: https://prim.iledefrance-mobilites.fr/
# Without this key, the app works but real-time features are disabled
PRIM_API_KEY=

# ─── Auth ──────────────────────────────────────────────────
# Secret key for JWT signing (min 32 characters)
# Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ─── Email (Resend) ───────────────────────────────────────
# Required for signup email verification
# Get a key at: https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxx
